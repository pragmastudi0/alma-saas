# Copiá este archivo a .env.local y completá los valores.
# Los secrets NUNCA van al repo.

# Proyecto Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://wioidjmgxlldmmampqnz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor / tests / seed. Jamás exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (links de confirmación de correo, OAuth y webhook de MP)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Aplicación de Mercado Pago (DevPortal → tu aplicación) — ver docs/mercado-pago.md
# Cada profesional conecta SU cuenta por OAuth; estos son los datos de la app, no de una cuenta vendedora.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Secret de firma del webhook (DevPortal → Webhooks)
MP_WEBHOOK_SECRET=
# Clave de cifrado de los tokens OAuth guardados en la base: 32 bytes en base64.
# Generarla con: openssl rand -base64 32
MP_TOKEN_ENC_KEY=
